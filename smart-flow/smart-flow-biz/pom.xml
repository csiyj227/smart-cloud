<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smart</groupId>
        <artifactId>smart-flow</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>smart-flow-biz</artifactId>
    <name>smart-flow-biz</name>
    <description>Business implementation of smart-flow (DDD layered)</description>

    <dependencies>
        <!-- Smart-flow public contracts -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-flow-api</artifactId>
        </dependency>

        <!-- Smart Data (MyBatis-Plus + Tenant + Redis) -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-data</artifactId>
        </dependency>

        <!-- Smart Security (resource server) -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-security</artifactId>
        </dependency>

        <!-- Smart Feign (cross-service calls to UPMS) -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-feign</artifactId>
        </dependency>

        <!-- UPMS contracts (RemoteUserService etc.) -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-system-api</artifactId>
        </dependency>

        <!-- Smart Log -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-log</artifactId>
        </dependency>

        <!-- Smart Swagger / Knife4j -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-swagger</artifactId>
        </dependency>

        <!-- ============== Flowable 7.x (Spring Boot 3 / Spring 6 / JDK 17) ============== -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
            <version>${flowable.version}</version>
            <exclusions>
                <!-- Use the MyBatis brought by mybatis-plus to avoid version conflict -->
                <exclusion>
                    <groupId>org.mybatis</groupId>
                    <artifactId>mybatis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Nacos discovery / config -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Spring Boot Validation Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Undertow Servlet Container -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
