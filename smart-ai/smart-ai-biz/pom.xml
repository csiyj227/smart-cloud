<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smart</groupId>
        <artifactId>smart-ai</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>smart-ai-biz</artifactId>
    <name>smart-ai-biz</name>
    <description>Business implementation of smart-ai (LLM / RAG / Agent / MCP)</description>

    <dependencies>
        <!-- Smart-ai public contracts -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-ai-api</artifactId>
        </dependency>

        <!-- Smart Data (MyBatis-Plus + Tenant + Redis) -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-data</artifactId>
        </dependency>

        <!-- Smart Security (resource server) -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-security</artifactId>
        </dependency>

        <!-- Smart Feign (cross-service calls to UPMS) -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-feign</artifactId>
        </dependency>

        <!-- UPMS contracts (RemoteUserService etc.) -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-system-api</artifactId>
        </dependency>

        <!-- Smart Log -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-log</artifactId>
        </dependency>

        <!-- Smart Swagger / Knife4j -->
        <dependency>
            <groupId>com.smart</groupId>
            <artifactId>smart-common-swagger</artifactId>
        </dependency>

        <!-- ============== Spring AI ============== -->
        <!--
            ⚠️ 注意：Spring AI 1.0.0 GA（2025-05 发布）后 artifactId 已改名：
            旧：spring-ai-openai-spring-boot-starter   （1.0.0-M* 里程碑版）
            新：spring-ai-starter-model-openai         （1.0.0 GA 起统一为 spring-ai-starter-model-*）
            参考：https://mvnrepository.com/artifact/org.springframework.ai/spring-ai-starter-model-openai/1.0.0
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- Spring WebFlux for SSE streaming -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Apache Tika for document parsing (PDF/Word/Excel) -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- pgvector Java client for vector storage -->
        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>${pgvector.version}</version>
        </dependency>

        <!-- Nacos discovery / config -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Spring Boot Validation Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Undertow Servlet Container -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
